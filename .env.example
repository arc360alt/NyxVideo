# Copy this file to .env and fill in your own key to enable Freesound search
# without every user having to paste in their own API key. Get a free key at
# https://freesound.org/apiv2/apply/
#
# Note: this ends up in the built client bundle (any VITE_-prefixed var does),
# so it's visible to anyone who opens dev tools on a deployed build — fine for
# local/personal use, not for a publicly shared deployment.
VITE_FREESOUND_API_KEY=

# Same idea for the Stock Content tab (Pexels photos & videos). Get a free key at
# https://www.pexels.com/api/new/
VITE_PEXELS_API_KEY=
